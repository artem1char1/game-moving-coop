{
  "version": 2,
  "routing": {
    "S": {
      "max_subagent_calls": 0,
      "default_roles": [],
      "owner": "coordinator"
    },
    "M": {
      "max_subagent_calls": 1,
      "default_roles": [],
      "owner": "coordinator",
      "review": "только при конкретном существенном риске"
    },
    "L": {
      "max_subagent_calls": 2,
      "default_roles": [
        "gamedev_developer"
      ],
      "plan_owner": "coordinator",
      "review": "QA по риску"
    },
    "C": {
      "max_subagent_calls": 2,
      "default_roles": [
        "qa_reviewer"
      ],
      "owner": "coordinator implements",
      "independent_qa_required": true,
      "plan_owner": "coordinator"
    }
  },
  "max_technical_retries": 1,
  "max_content_revision_rounds": 2,
  "handoff_words": 120,
  "fresh_agents_fork_turns": "none",
  "wait_ms": 45000,
  "budget_mode": "advisory; required checks preserved; coordinator records extensions",
  "models": {
    "active": "inherit",
    "automatic_switching": false,
    "reason": "Нет отдельного назначения моделей пользователем; доступные счётчики стоимости отсутствуют"
  },
  "token_limit_enforced": false,
  "cache_control": "platform-managed; no claimed manual cache",
  "pilot_targets": {
    "median_tokens_reduction": 0.3,
    "repeat_reads_reduction": 0.5
  },
  "initial_files_by_class": {
    "S": [
      1,
      2
    ],
    "M": [
      1,
      4
    ],
    "L": [
      3,
      8
    ],
    "C": [
      3,
      8
    ]
  },
  "preflight_command": "python .codex/check_route.py --class CLASS --role ROLE --calls-used N --reason REASON",
  "review_rule": "Автор исправляет сам; reviewer возвращает defects, повторная проверка только затронутого. Независимый QA критичных изменений сохраняется."
}
